{
  "name": "@mahfil/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src prisma --max-warnings=0",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "security:preflight": "tsx scripts/security-preflight.ts",
    "release:deploy": "pnpm security:preflight && prisma migrate deploy",
    "openapi:generate": "tsx scripts/generate-openapi.ts && openapi-typescript openapi.json -o ../web/src/types/generated-api.ts && openapi-typescript openapi.json -o ../mobile/src/types/generated-api.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fontsource/noto-sans-bengali": "^5.2.11",
    "@json2csv/plainjs": "^7.0.6",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "@supabase/storage-js": "^2.117.2",
    "bcrypt": "^6.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.0.1",
    "file-type": "^21.3.4",
    "jose": "^6.1.0",
    "nodemailer": "^10.0.13",
    "pdfmake": "^0.3.6",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfmake": "^0.3.2",
    "eslint": "^9.39.4",
    "openapi-typescript": "^7.10.1",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "uuid": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}
