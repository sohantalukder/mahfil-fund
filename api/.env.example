NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=mahfil-fund-api
JWT_AUDIENCE=mahfil-fund-clients

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mahfil_fund

# Supabase private object storage only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=mahfil-uploads

# Maximum communities a non-super-admin can create
ADMIN_COMMUNITY_LIMIT=10

# Mailtrap SMTP (https://mailtrap.io)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_username
MAILTRAP_PASS=your_mailtrap_password
MAIL_FROM=noreply@mahfilfund.com

# OTP validity in minutes
OTP_EXPIRY_MINUTES=10

# Required only while running `prisma db seed`; never reuse this password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-random-password

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# If running behind a proxy/load balancer
TRUST_PROXY=loopback,linklocal,uniquelocal
