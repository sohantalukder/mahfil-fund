generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform-level enums ────────────────────────────────────────────────────

enum CommunityRole {
  ADMIN
  COLLECTOR
  VIEWER
}

enum Locale {
  bn
  en
}

enum DonorType {
  individual
  family
  business
  organization
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK
}

enum RecordStatus {
  ACTIVE
  DELETED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum SyncOpStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
}

enum SyncItemStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
}

enum AttachmentStatus {
  PENDING
  READY
  DELETING
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxJobType {
  CREATE_DONATION_INVOICE
  GENERATE_INVOICE_PDF
  DELETE_STORAGE_OBJECT
}

enum SecurityEventType {
  TOKEN_FAMILY_CREATED
  TOKEN_ROTATED
  TOKEN_REUSE_DETECTED
  TOKEN_FAMILY_REVOKED
  ACCOUNT_TOKENS_REVOKED
}

enum OtpType {
  PASSWORD_RESET
}

// ─── Tenant-level enums ──────────────────────────────────────────────────────

enum CommunityStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvoiceType {
  DONATION_RECEIPT
  SPONSOR_RECEIPT
  MANUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum ErrorLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ErrorSource {
  API
  MOBILE
  WEB
  ADMIN
  SYNC
  UPLOAD
  EMAIL
}

// ─── Platform-level models ────────────────────────────────────────────────────

model User {
  id                 String  @id @default(uuid()) @db.Uuid
  email              String
  passwordHash       String
  phone              String?
  fullName           String?
  isActive           Boolean @default(true)
  isSuperAdmin       Boolean @default(false)
  mustChangePassword Boolean @default(false)

  refreshTokens RefreshToken[]

  // Community relations
  communitiesCreated Community[]           @relation("CommunityCreatedBy")
  memberships        CommunityMembership[]
  membershipsAdded   CommunityMembership[] @relation("MembershipAddedBy")

  // Entity audit relations
  eventsCreated    Event[]    @relation("EventCreatedBy")
  eventsUpdated    Event[]    @relation("EventUpdatedBy")
  donorsCreated    Donor[]    @relation("DonorCreatedBy")
  donorsUpdated    Donor[]    @relation("DonorUpdatedBy")
  donationsCreated Donation[] @relation("DonationCreatedBy")
  donationsUpdated Donation[] @relation("DonationUpdatedBy")
  expensesCreated  Expense[]  @relation("ExpenseCreatedBy")
  expensesUpdated  Expense[]  @relation("ExpenseUpdatedBy")
  invoicesCreated  Invoice[]  @relation("InvoiceCreatedBy")
  invoicesUpdated  Invoice[]  @relation("InvoiceUpdatedBy")

  auditLogs          AuditLog[]
  syncOperations     SyncOperation[]
  idempotencyKeys    IdempotencyKey[]
  syncOperationItems SyncOperationItem[]
  outboxJobsCreated  OutboxJob[]         @relation("OutboxJobCreatedBy")
  securityEvents     SecurityEvent[]
  errorLogs          ErrorLog[]          @relation("ErrorLogUser")
  errorReviews       ErrorLog[]          @relation("ErrorLogReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model MigrationAudit {
  id          String   @id @default(uuid()) @db.Uuid
  migration   String   @unique
  counts      Json
  completedAt DateTime @default(now())
}

model Otp {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String
  type      OtpType
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([email, type])
  @@index([expiresAt, used])
}

model RecoveryThrottle {
  identifierHash  String
  kind            String
  hits            Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([identifierHash, kind])
  @@index([windowStartedAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt, revokedAt])
}

model SecurityEvent {
  id         String            @id @default(uuid()) @db.Uuid
  type       SecurityEventType
  userId     String?           @db.Uuid
  familyId   String?           @db.Uuid
  client     String?
  deviceHash String?
  createdAt  DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([familyId, createdAt])
  @@index([type, createdAt])
}

// ─── Tenant / Community models ────────────────────────────────────────────────

model Community {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  slug             String          @unique
  description      String?
  logoAttachmentId String?         @db.Uuid
  location         String?
  district         String?
  thana            String?
  contactNumber    String?
  email            String?
  status           CommunityStatus @default(ACTIVE)
  createdByUserId  String          @db.Uuid

  createdBy          User                  @relation("CommunityCreatedBy", fields: [createdByUserId], references: [id])
  logoAttachment     Attachment?           @relation("CommunityLogo", fields: [logoAttachmentId, id], references: [id, communityId])
  memberships        CommunityMembership[]
  events             Event[]
  donors             Donor[]
  donations          Donation[]
  expenses           Expense[]
  invoices           Invoice[]
  attachments        Attachment[]          @relation("CommunityAttachments")
  auditLogs          AuditLog[]
  errorLogs          ErrorLog[]
  syncOperations     SyncOperation[]
  idempotencyKeys    IdempotencyKey[]
  syncOperationItems SyncOperationItem[]
  invoiceSequences   InvoiceSequence[]
  outboxJobs         OutboxJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([createdByUserId])
  @@index([status])
}

model CommunityMembership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  communityId   String           @db.Uuid
  role          CommunityRole
  status        MembershipStatus @default(ACTIVE)
  addedByUserId String?          @db.Uuid
  joinedAt      DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation("MembershipAddedBy", fields: [addedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, communityId])
  @@index([communityId, status])
  @@index([userId])
}

// ─── Domain models ────────────────────────────────────────────────────────────

model Event {
  id                String  @id @default(uuid()) @db.Uuid
  clientGeneratedId String? @db.Uuid
  communityId       String  @db.Uuid

  name     String
  year     Int
  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(false)

  status          RecordStatus @default(ACTIVE)
  createdByUserId String?      @db.Uuid
  updatedByUserId String?      @db.Uuid
  createdMetaId   String?      @db.Uuid

  community   Community        @relation(fields: [communityId], references: [id])
  createdBy   User?            @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy   User?            @relation("EventUpdatedBy", fields: [updatedByUserId], references: [id])
  createdMeta RequestMetadata? @relation("EventCreatedMeta", fields: [createdMetaId], references: [id])

  donations Donation[]
  expenses  Expense[]
  invoices  Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, clientGeneratedId])
  @@unique([id, communityId])
  @@index([communityId, isActive])
  @@index([communityId, year])
  @@index([isActive])
}

model Donor {
  id                String  @id @default(uuid()) @db.Uuid
  clientGeneratedId String? @db.Uuid
  communityId       String  @db.Uuid

  fullName            String
  phone               String
  altPhone            String?
  address             String?
  area                String?
  district            String?
  thana               String?
  donorType           DonorType
  note                String?
  preferredLanguage   Locale    @default(bn)
  tags                String[]  @default([])
  profileAttachmentId String?   @db.Uuid

  status          RecordStatus @default(ACTIVE)
  createdByUserId String?      @db.Uuid
  updatedByUserId String?      @db.Uuid
  createdMetaId   String?      @db.Uuid

  community         Community        @relation(fields: [communityId], references: [id])
  profileAttachment Attachment?      @relation("DonorProfile", fields: [profileAttachmentId, communityId], references: [id, communityId])
  createdBy         User?            @relation("DonorCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy         User?            @relation("DonorUpdatedBy", fields: [updatedByUserId], references: [id])
  createdMeta       RequestMetadata? @relation("DonorCreatedMeta", fields: [createdMetaId], references: [id])

  donations Donation[]
  invoices  Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, clientGeneratedId])
  @@unique([id, communityId])
  @@index([communityId])
  @@index([phone])
  @@index([fullName])
}

model Donation {
  id                String  @id @default(uuid()) @db.Uuid
  clientGeneratedId String? @db.Uuid
  communityId       String  @db.Uuid

  eventId            String        @db.Uuid
  donorId            String        @db.Uuid
  donorSnapshotName  String
  donorSnapshotPhone String
  amount             Int
  paymentMethod      PaymentMethod
  donationDate       DateTime
  note               String?
  receiptNo          String?
  transactionId      String?
  proofAttachmentId  String?       @db.Uuid

  status          RecordStatus @default(ACTIVE)
  createdByUserId String?      @db.Uuid
  updatedByUserId String?      @db.Uuid
  createdMetaId   String?      @db.Uuid

  community       Community        @relation(fields: [communityId], references: [id])
  event           Event            @relation(fields: [eventId, communityId], references: [id, communityId], onDelete: Restrict)
  donor           Donor            @relation(fields: [donorId, communityId], references: [id, communityId], onDelete: Restrict)
  proofAttachment Attachment?      @relation("DonationProof", fields: [proofAttachmentId, communityId], references: [id, communityId])
  createdBy       User?            @relation("DonationCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy       User?            @relation("DonationUpdatedBy", fields: [updatedByUserId], references: [id])
  createdMeta     RequestMetadata? @relation("DonationCreatedMeta", fields: [createdMetaId], references: [id])

  invoices Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, clientGeneratedId])
  @@unique([id, communityId])
  @@index([communityId])
  @@index([eventId, donationDate])
  @@index([donorId, eventId])
}

model Expense {
  id                String  @id @default(uuid()) @db.Uuid
  clientGeneratedId String? @db.Uuid
  communityId       String  @db.Uuid

  eventId             String        @db.Uuid
  title               String
  category            String
  amount              Int
  expenseDate         DateTime
  vendor              String?
  paymentMethod       PaymentMethod
  note                String?
  receiptAttachmentId String?       @db.Uuid

  status          RecordStatus @default(ACTIVE)
  createdByUserId String?      @db.Uuid
  updatedByUserId String?      @db.Uuid
  createdMetaId   String?      @db.Uuid

  community         Community        @relation(fields: [communityId], references: [id])
  event             Event            @relation(fields: [eventId, communityId], references: [id, communityId], onDelete: Restrict)
  receiptAttachment Attachment?      @relation("ExpenseReceipt", fields: [receiptAttachmentId, communityId], references: [id, communityId])
  createdBy         User?            @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy         User?            @relation("ExpenseUpdatedBy", fields: [updatedByUserId], references: [id])
  createdMeta       RequestMetadata? @relation("ExpenseCreatedMeta", fields: [createdMetaId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, clientGeneratedId])
  @@index([communityId])
  @@index([eventId, expenseDate])
  @@index([category])
}

model Invoice {
  id          String  @id @default(uuid()) @db.Uuid
  communityId String  @db.Uuid
  eventId     String? @db.Uuid
  donorId     String? @db.Uuid
  donationId  String? @db.Uuid

  invoiceNumber       String
  invoiceType         InvoiceType
  issueDate           DateTime
  payerName           String
  payerPhone          String?
  payerAddress        String?
  amount              Int
  amountInWordsBangla String?
  paymentMethod       PaymentMethod?
  referenceNumber     String?
  note                String?
  status              InvoiceStatus  @default(DRAFT)
  pdfAttachmentId     String?        @db.Uuid
  createdByUserId     String?        @db.Uuid
  updatedByUserId     String?        @db.Uuid

  community     Community   @relation(fields: [communityId], references: [id])
  event         Event?      @relation(fields: [eventId, communityId], references: [id, communityId])
  donor         Donor?      @relation(fields: [donorId, communityId], references: [id, communityId])
  donation      Donation?   @relation(fields: [donationId, communityId], references: [id, communityId])
  pdfAttachment Attachment? @relation("InvoicePdf", fields: [pdfAttachmentId, communityId], references: [id, communityId])
  createdBy     User?       @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy     User?       @relation("InvoiceUpdatedBy", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, invoiceNumber])
  @@unique([id, communityId])
  @@index([communityId])
  @@index([donationId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceSequence {
  communityId String    @db.Uuid
  year        Int
  current     Int       @default(0)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([communityId, year])
}

model Attachment {
  id               String           @id @default(uuid()) @db.Uuid
  communityId      String           @db.Uuid
  entityType       String?
  entityId         String?
  bucket           String
  objectPath       String
  originalName     String?
  mimeType         String?
  sizeBytes        Int?
  isPublic         Boolean          @default(false)
  uploadedByUserId String?          @db.Uuid
  status           AttachmentStatus @default(PENDING)

  community        Community   @relation("CommunityAttachments", fields: [communityId], references: [id])
  communityLogoFor Community[] @relation("CommunityLogo")
  donorProfiles    Donor[]     @relation("DonorProfile")
  donationProofs   Donation[]  @relation("DonationProof")
  expenseReceipts  Expense[]   @relation("ExpenseReceipt")
  invoicePdfs      Invoice[]   @relation("InvoicePdf")

  createdAt DateTime @default(now())

  @@unique([id, communityId])
  @@index([communityId])
  @@index([entityType, entityId])
  @@index([status, createdAt])
}

model RequestMetadata {
  id         String   @id @default(uuid()) @db.Uuid
  ip         String?
  userAgent  String?
  deviceType String?
  client     String?
  deviceId   String?
  createdAt  DateTime @default(now())

  createdEvents    Event[]    @relation("EventCreatedMeta")
  createdDonors    Donor[]    @relation("DonorCreatedMeta")
  createdDonations Donation[] @relation("DonationCreatedMeta")
  createdExpenses  Expense[]  @relation("ExpenseCreatedMeta")
  auditLogs        AuditLog[] @relation("AuditLogMeta")

  @@index([deviceId])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  communityId String?     @db.Uuid
  entityType  String
  entityId    String      @db.Uuid
  action      AuditAction
  actorUserId String?     @db.Uuid
  actorRole   String?
  before      Json?
  after       Json?
  metaId      String?     @db.Uuid

  community Community?       @relation(fields: [communityId], references: [id])
  meta      RequestMetadata? @relation("AuditLogMeta", fields: [metaId], references: [id])
  actor     User?            @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([communityId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ErrorLog {
  id          String      @id @default(uuid()) @db.Uuid
  level       ErrorLevel
  source      ErrorSource
  communityId String?     @db.Uuid
  userId      String?     @db.Uuid
  requestId   String?
  routeName   String?
  actionName  String?
  errorCode   String?
  message     String
  stackTrace  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  reviewedBy  String?     @db.Uuid
  reviewedAt  DateTime?

  community Community? @relation(fields: [communityId], references: [id])
  user      User?      @relation("ErrorLogUser", fields: [userId], references: [id])
  reviewer  User?      @relation("ErrorLogReviewer", fields: [reviewedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([communityId])
  @@index([createdAt])
  @@index([errorCode])
}

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  key          String
  userId       String            @db.Uuid
  communityId  String            @db.Uuid
  method       String
  path         String
  requestHash  String?
  responseBody Json?
  statusCode   Int?
  status       IdempotencyStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  expiresAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId, method, path, key])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model SyncOperation {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  communityId String       @db.Uuid
  deviceId    String
  status      SyncOpStatus @default(PENDING)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  error       String?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community           @relation(fields: [communityId], references: [id])
  items     SyncOperationItem[]

  @@index([userId, deviceId])
  @@index([status, startedAt])
  @@index([communityId])
}

model SyncOperationItem {
  id              String         @id @default(uuid()) @db.Uuid
  syncOperationId String         @db.Uuid
  userId          String         @db.Uuid
  communityId     String         @db.Uuid
  deviceId        String
  opId            String         @db.Uuid
  status          SyncItemStatus @default(PENDING)
  success         Boolean?
  serverId        String?        @db.Uuid
  error           String?
  createdAt       DateTime       @default(now())

  syncOperation SyncOperation @relation(fields: [syncOperationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  community     Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId, deviceId, opId])
  @@index([syncOperationId])
  @@index([status, createdAt])
}

model OutboxJob {
  id              String          @id @default(uuid()) @db.Uuid
  type            OutboxJobType
  status          OutboxJobStatus @default(PENDING)
  communityId     String          @db.Uuid
  entityId        String          @db.Uuid
  objectBucket    String?
  objectPath      String?
  createdByUserId String?         @db.Uuid
  attempts        Int             @default(0)
  maxAttempts     Int             @default(5)
  availableAt     DateTime        @default(now())
  leaseUntil      DateTime?
  lastErrorCode   String?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("OutboxJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([leaseUntil])
  @@index([communityId, entityId])
}
